{
  "name": "@donotdev/ui",
  "version": "0.1.42",
  "type": "module",
  "private": false,
  "license": "MIT",
  "description": "UI components for DoNotDev.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "import": "./src/vite.ts",
      "default": "./src/vite.ts"
    },
    "./next": {
      "types": "./src/next.ts",
      "import": "./src/next.ts",
      "default": "./src/next.ts"
    },
    "./routing/hooks": {
      "types": "./src/routing/hooks/hooks.next.ts",
      "vite-app": "./src/routing/hooks/hooks.vite.ts",
      "import": "./src/routing/hooks/hooks.next.ts",
      "default": "./src/routing/hooks/hooks.next.ts"
    },
    "./dndev.css": "./src/dndev.css",
    "./dndev-next.css": "./src/dndev-next.css"
  },
  "files": [
    "dist",
    "assets",
    "guidelines",
    "package.json",
    "README.md",
    "LICENSE.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "tsc --noEmit --watch --listFiles false --listEmittedFiles false",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "type-check": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@fontsource/press-start-2p": "^5.2.5",
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/space-grotesk": "^5.2.10"
  },
  "peerDependencies": {
    "@donotdev/ai": "^0.1.42",
    "@donotdev/auth": "^0.1.42",
    "@donotdev/billing": "^0.1.42",
    "@donotdev/components": "^0.1.42",
    "@donotdev/core": "^0.1.42",
    "@donotdev/crud": "^0.1.42",
    "@donotdev/oauth": "^0.1.42",
    "@hookform/resolvers": "^5.2.2",
    "lucide-react": "^0.575.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.71.2",
    "react-router-dom": "^7.13.1",
    "valibot": "^1.2.0"
  },
  "peerDependenciesMeta": {
    "@donotdev/ai": {
      "optional": true
    },
    "@donotdev/auth": {
      "optional": true
    },
    "@donotdev/billing": {
      "optional": true
    },
    "@donotdev/crud": {
      "optional": true
    },
    "@donotdev/oauth": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@donotdev/ai": "workspace:*",
    "@donotdev/auth": "workspace:*",
    "@donotdev/billing": "workspace:*",
    "@donotdev/components": "workspace:*",
    "@donotdev/core": "workspace:*",
    "@donotdev/crud": "workspace:*",
    "@donotdev/oauth": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.575.0",
    "next": "^16.1.4",
    "postcss-import": "^16.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.71.2",
    "react-router-dom": "^7.13.1",
    "valibot": "^1.2.0",
    "vite": "7.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/donotdev/ui.git"
  },
  "keywords": [
    "donotdev",
    "dndev",
    "react",
    "ui",
    "composition",
    "routing",
    "forms",
    "react-hook-form",
    "typescript",
    "vite",
    "nextjs"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}